# Flask service
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=5000
LOG_LEVEL=INFO
# Comma-separated exact origins, e.g. http://localhost:5173,https://username.github.io
CORS_ALLOWED_ORIGINS=http://localhost:5173
HEALTHCHECK_TIMEOUT_SECONDS=2
SUPABASE_RPC_TIMEOUT_SECONDS=10

# Supabase project (public project URL and publishable/anon key only).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# JWT verification: prefer Supabase JWKS for asymmetric signing keys.
# If using the legacy HS256 signing secret, set SUPABASE_JWT_SECRET and leave
# SUPABASE_JWKS_URL blank. Never put service_role keys or signing keys in frontend code.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
JWT_LEEWAY_SECONDS=30

# Optional direct PostgreSQL URL used by health checks or the retention worker.
# Store this only in the backend runtime secret manager / local .env, never commit it.
# Use a restricted, dedicated database credential for maintenance jobs.
DATABASE_URL=
IDEMPOTENCY_PRUNER_INTERVAL_SECONDS=300
