# Frontend values are baked into the browser bundle at image-build time.
# Use only the Supabase publishable/anon key here, never the service_role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Local Compose default. For deployment, use the public HTTPS Flask API URL.
VITE_API_BASE_URL=http://localhost:5000/api/v1
